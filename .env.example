# GEMINI_API_KEY: clave del asistente de IA. SOLO en el servidor — nunca se
# expone al navegador. En producción se configura como secreto del Worker de
# Cloudflare (wrangler secret put GEMINI_API_KEY) y en local en .env.local.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL (opcional): modelo a usar. Por defecto "gemini-2.5-flash".
# Se puede cambiar a uno más reciente (p. ej. "gemini-3.6-flash") sin tocar el código.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# NEXT_PUBLIC_TESTIMONIALS_ENABLED: Controls whether the testimonials section is displayed on the home page.
# Set to "true" to enable, "false" or omit to disable.
NEXT_PUBLIC_TESTIMONIALS_ENABLED="false"
