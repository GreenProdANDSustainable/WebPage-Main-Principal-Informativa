# GEMINI_API_KEY: clave del asistente de IA. SOLO en el servidor — nunca se
# expone al navegador. En producción se configura como secreto del Worker de
# Cloudflare (wrangler secret put GEMINI_API_KEY) y en local en .env.local.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL (opcional): modelo a usar. Por defecto "gemini-2.5-flash".
# Se puede cambiar a uno más reciente (p. ej. "gemini-3.6-flash") sin tocar el código.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# RESEND_API_KEY: clave del servicio que envia los correos de la suscripcion
# a novedades (https://resend.com). SOLO en el servidor. En produccion va como
# secreto del Worker (wrangler secret put RESEND_API_KEY) y en local en
# .env.local. Sin esta clave, /api/suscripcion responde 503 y el formulario
# avisa que no se pudo completar: nunca finge que el correo salio.
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# NEWSLETTER_FROM (opcional): remitente del correo de bienvenida. El dominio
# tiene que estar verificado en Resend. Por defecto "Green Prod <novedades@greenprod.pe>".
NEWSLETTER_FROM="Green Prod <novedades@greenprod.pe>"

# NEWSLETTER_NOTIFY (opcional): correo de la empresa que recibe el aviso de
# cada alta. Hace de lista de suscriptores mientras no haya base de datos.
NEWSLETTER_NOTIFY="gerencia@greenprod.pe"
